# Copia este archivo como .env (junto al pom.xml) y llena tus valores.
# El .env real NO se sube a git.

# Puerto del backend
SERVER_PORT=8080

# Conexión a MongoDB. Si tu Mongo no tiene usuario, usa mongodb://localhost:27017/imprenta
# Si la contraseña tiene caracteres como @ : / hay que codificarlos (ej. @ = %40)
MONGODB_URI=mongodb://USUARIO:PASSWORD@localhost:27017/imprenta?authSource=admin

# JWT
APP_JWT_SECRET=pon_aqui_una_llave_larga_y_aleatoria
APP_JWT_EXPIRATION_MS=28800000

# Frontend autorizado para consumir la API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Usuarios que se crean al arrancar el backend si no existen
APP_ADMIN_USUARIO=admin
APP_ADMIN_PASSWORD=cambia_esta_contrasena
APP_ADMIN_NOMBRE=Administrador

APP_SECRETARIA_USUARIO=secretaria
APP_SECRETARIA_PASSWORD=cambia_esta_contrasena
APP_SECRETARIA_NOMBRE=Secretaria de pruebas
